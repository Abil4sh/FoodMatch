# Frontend configuration. Vite exposes every VITE_* variable to the browser,
# so nothing secret may ever be placed here.

# Where the Django API is running.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# On Vercel, set this in Project Settings -> Environment Variables to the
# deployed Django origin, e.g. https://api.yourdomain.com
# It is a public URL, not a secret. If it is missing in a production build the
# app falls back to same-origin /api requests and warns in the console.

# There is deliberately NO provider key in this file, and there never should be.
# The Geoapify key is server-side only: it lives in backend/.env, which is
# gitignored, and the browser never sees it. Never create VITE_GEOAPIFY_API_KEY.
