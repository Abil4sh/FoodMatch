# Frontend configuration. Vite exposes every VITE_* variable to the browser,
# so nothing secret may ever be placed here.

# Where the Django API is running.
VITE_API_BASE_URL=http://127.0.0.1:8000

# There is deliberately NO Google key in this file, and there never should be.
# A server-side key belongs in backend/.env, which is gitignored and never
# read by the frontend.
