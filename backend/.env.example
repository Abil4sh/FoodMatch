# Copy to .env and fill in. .env is gitignored; this template is tracked.
# Never put a real secret in this file.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request throttling
DJANGO_THROTTLE_CATALOG=120/min
DJANGO_THROTTLE_DETAIL=60/min
DJANGO_THROTTLE_SEARCH=15/min

# --- Geoapify Places ---------------------------------------------------------
# SERVER-SIDE ONLY. Never copy this into any VITE_* variable.
# Leave EMPTY to run FoodMatch with the bundled local catalog.
GEOAPIFY_API_KEY=
