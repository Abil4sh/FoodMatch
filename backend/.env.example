# Copy to .env and fill in. .env is gitignored; this template is tracked.
# Never put a real secret in this file.

# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local SQLite (no setup needed).
# For production, set a PostgreSQL URL:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DJANGO_DB_SSLMODE=require

# Comma-separated origins allowed to call the API from a browser.
# Add your Vercel origin here when you deploy the frontend, e.g.
# http://localhost:5173,https://foodmatch.vercel.app
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request throttling
DJANGO_THROTTLE_CATALOG=120/min
DJANGO_THROTTLE_DETAIL=60/min

# Request throttling for the search endpoint (the only one that can reach
# Google). Lower is safer.
DJANGO_THROTTLE_SEARCH=15/min

# --- Places provider (Geoapify) ----------------------------------------------
# SERVER-SIDE ONLY. Never copy this into any VITE_* variable, into the frontend,
# or into a commit. Leave it EMPTY to run FoodMatch entirely on the bundled
# catalog with zero outbound requests.
GEOAPIFY_API_KEY=

# How long a provider response may be held in process memory, in seconds.
# In-memory only; nothing is written to disk.
GEOAPIFY_CACHE_TTL=600

# Default search centre used when the client sends no coordinates.
# Not a secret. Defaults to HSR Layout, Bengaluru.
FOODMATCH_DEFAULT_LAT=12.9121
FOODMATCH_DEFAULT_LNG=77.6446
